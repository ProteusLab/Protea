abstract struct Packet {
    b64 getAddr();
    int getSize();
    b8 getByte();
    void setByte(b8 value);
    b32 getWord();
    void setWord(b32 value);
    void makeAtomicResponse();
}
abstract struct CheckpointOut {}
abstract struct CheckpointIn {}
abstract struct AddrRange {}
abstract struct AddrRangeList { void push(AddrRange value); }
abstract AddrRange rangeSize(b64 base, b64 size);
abstract void require(bool condition);
abstract void panicIf(bool condition, string message);
abstract void fatalIf(bool condition, string message);
abstract void fail(string message);
abstract void warn(string message);
abstract string toString(int value);
abstract void saveScalar(CheckpointOut& cp, string key, auto value);
abstract b64 loadScalar(CheckpointIn& cp, string key);
abstract void saveArray(CheckpointOut& cp, string key, auto values);
abstract void loadArray(CheckpointIn& cp, string key, auto values);
abstract struct IntSourcePinBase {
    void raise();
    void lower();
}
abstract struct IntSinkPinBase {
    int getId();
    bool state();
}
abstract IntSourcePinBase* newSourcePin(string name, int id, auto owner);
abstract IntSinkPinBase* newSinkPin(string name, int id, auto owner);
abstract struct Ps2Device {
    void hostWrite(b8 data);
    bool hostDataAvailable();
    b8 hostRead();
}
abstract struct I8042Params {
    b64 pio_latency;
    b64 data_port;
    b64 command_port;
    Ps2Device* mouse;
    Ps2Device* keyboard;
    int port_keyboard_int_pin_connection_count;
    int port_mouse_int_pin_connection_count;
}

device I8042 {
    b64 latency;
    b64 dataPort;
    b64 commandPort;
    b8 statusReg;
    b8 commandByte;
    b8 dataReg;
    b16 lastCommand;
    vector<IntSourcePinBase*> mouseIntPin;
    vector<IntSourcePinBase*> keyboardIntPin;
    Ps2Device* mouse;
    Ps2Device* keyboard;
    abstract string name();
    const b16 no_command = 0xffff;

    constructor(I8042Params& params) : latency(params.pio_latency), dataPort(params.data_port),
        commandPort(params.command_port), statusReg(0x10), commandByte(0x70), dataReg(0),
        lastCommand(no_command), mouse(params.mouse), keyboard(params.keyboard) {
        fatalIf(mouse == 0, "The i8042 model requires a mouse instance");
        fatalIf(keyboard == 0, "The i8042 model requires a keyboard instance");
        for (int i = 0; i < params.port_keyboard_int_pin_connection_count; ++i) {
            keyboardIntPin.push(newSourcePin(name() + ".keyboard_int_pin[" + toString(i) + "]", i, self));
        }
        for (int i = 0; i < params.port_mouse_int_pin_connection_count; ++i) {
            mouseIntPin.push(newSourcePin(name() + ".mouse_int_pin[" + toString(i) + "]", i, self));
        }
    }
    AddrRangeList getAddrRanges() const {
        AddrRangeList ranges;
        ranges.push(rangeSize(dataPort, 1));
        ranges.push(rangeSize(commandPort, 1));
        return ranges;
    }
    void writeData(b8 newData, bool fromMouse) {
        dataReg = newData;
        statusReg = (statusReg & 0xdf) | 1;
        if (fromMouse) { statusReg |= 0x20; }
        if ((fromMouse == 0) & ((commandByte & 1) != 0)) {
            for (int i = 0; i < keyboardIntPin.size(); ++i) {
                keyboardIntPin.at(i).raise();
                keyboardIntPin.at(i).lower();
            }
        } else if (fromMouse & ((commandByte & 2) != 0)) {
            for (int i = 0; i < mouseIntPin.size(); ++i) {
                mouseIntPin.at(i).raise();
                mouseIntPin.at(i).lower();
            }
        }
    }
    register output_buffer: size(1), offset(0), type(ro) {
        b8 read() {
            b8 data = dataReg;
            statusReg &= 0xde;
            if (keyboard.hostDataAvailable()) { writeData(keyboard.hostRead(), 0); }
            else if (mouse.hostDataAvailable()) { writeData(mouse.hostRead(), 1); }
            return data;
        }
    }
    register input_buffer: size(1), offset(0), type(wo) {
        void write(b8 data) {
            statusReg &= 0xf7;
            if (lastCommand == no_command) {
                keyboard.hostWrite(data);
                if (keyboard.hostDataAvailable()) { writeData(keyboard.hostRead(), 0); }
            } else if (lastCommand == 0xd4) {
                mouse.hostWrite(data);
                if (mouse.hostDataAvailable()) { writeData(mouse.hostRead(), 1); }
            } else if (lastCommand == 0x60) { commandByte = data; }
            else if (lastCommand == 0xd3) { writeData(data, 1); }
            else if (lastCommand == 0xd2) { writeData(data, 0); }
            else if (lastCommand == 0xd1) { panicIf((data & 1) != 1, "Reset bit should be 1"); }
            else { fail("Data written for unrecognized i8042 command"); }
            lastCommand = no_command;
        }
    }
    register status: size(1), offset(4), type(ro) {
        b8 read() { return statusReg; }
    }
    register command: size(1), offset(4), type(wo) {
        void write(b8 data) {
            statusReg |= 8;
            panicIf((data > 0x20) & (data < 0x40), "Unimplemented i8042 read controller RAM");
            panicIf((data > 0x60) & (data < 0x80), "Unimplemented i8042 write controller RAM");
            panicIf((data >= 0xf0) & (data < 0xfe), "Unimplemented i8042 pulse output bit");
            if (data == 0x20) { writeData(commandByte, 0); }
            else if ((data == 0x60) | (data == 0xd1) | (data == 0xd2) | (data == 0xd3) | (data == 0xd4)) {
                lastCommand = data;
            } else if (data == 0xa7) { commandByte |= 0x20; }
            else if (data == 0xa8) { commandByte &= 0xdf; }
            else if ((data == 0xa9) | (data == 0xab)) { writeData(0, 0); }
            else if (data == 0xaa) {
                commandByte |= 0x74;
                statusReg |= 4;
                writeData(0x55, 0);
            } else if (data == 0xad) { commandByte |= 0x10; }
            else if (data == 0xae) { commandByte &= 0xef; }
            else if ((data == 0xa4) | (data == 0xa5) | (data == 0xa6) | (data == 0xac) |
                     (data == 0xc0) | (data == 0xc1) | (data == 0xc2) | (data == 0xd0) |
                     (data == 0xdd) | (data == 0xdf) | (data == 0xe0) | (data == 0xfe)) {
                fail("Unimplemented i8042 command");
            } else { warn("Write to unknown i8042 command port"); }
        }
    }
    b64 read(Packet* pkt) {
        require(pkt.getSize() == 1);
        b64 addr = pkt.getAddr();
        if (addr == dataPort) { pkt.setByte(output_buffer.read()); }
        else if (addr == commandPort) { pkt.setByte(status.read()); }
        else { fail("Read from unrecognized i8042 port"); }
        pkt.makeAtomicResponse();
        return latency;
    }
    b64 write(Packet* pkt) {
        require(pkt.getSize() == 1);
        b64 addr = pkt.getAddr();
        b8 data = pkt.getByte();
        if (addr == dataPort) { input_buffer.write(data); }
        else if (addr == commandPort) { command.write(data); }
        else { fail("Write to unrecognized i8042 port"); }
        pkt.makeAtomicResponse();
        return latency;
    }
    void serialize(CheckpointOut& cp) const {
        saveScalar(cp, "dataPort", dataPort);
        saveScalar(cp, "commandPort", commandPort);
        saveScalar(cp, "statusReg", statusReg);
        saveScalar(cp, "commandByte", commandByte);
        saveScalar(cp, "dataReg", dataReg);
        saveScalar(cp, "lastCommand", lastCommand);
    }
    void unserialize(CheckpointIn& cp) {
        dataPort = static_cast<b64>(loadScalar(cp, "dataPort"));
        commandPort = static_cast<b64>(loadScalar(cp, "commandPort"));
        statusReg = static_cast<b8>(loadScalar(cp, "statusReg"));
        commandByte = static_cast<b8>(loadScalar(cp, "commandByte"));
        dataReg = static_cast<b8>(loadScalar(cp, "dataReg"));
        lastCommand = static_cast<b16>(loadScalar(cp, "lastCommand"));
    }
}
