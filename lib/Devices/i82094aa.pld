abstract struct Packet {
    b64 getAddr();
    int getSize();
    b8 getByte();
    void setByte(b8 value);
    b32 getWord();
    void setWord(b32 value);
    void makeAtomicResponse();
}
abstract struct CheckpointOut {}
abstract struct CheckpointIn {}
abstract struct AddrRange {}
abstract struct AddrRangeList { void push(AddrRange value); }
abstract AddrRange rangeSize(b64 base, b64 size);
abstract void require(bool condition);
abstract void panicIf(bool condition, string message);
abstract void fatalIf(bool condition, string message);
abstract void fail(string message);
abstract void warn(string message);
abstract string toString(int value);
abstract void saveScalar(CheckpointOut& cp, string key, auto value);
abstract b64 loadScalar(CheckpointIn& cp, string key);
abstract void saveArray(CheckpointOut& cp, string key, auto values);
abstract void loadArray(CheckpointIn& cp, string key, auto values);
abstract struct IntSourcePinBase {
    void raise();
    void lower();
}
abstract struct IntSinkPinBase {
    int getId();
    bool state();
}
abstract IntSourcePinBase* newSourcePin(string name, int id, auto owner);
abstract IntSinkPinBase* newSinkPin(string name, int id, auto owner);
abstract struct TriggerMessage {
    b32 destination;
    b32 vector;
    b32 deliveryMode;
    b32 destMode;
    b32 level;
    b32 trigger;
}
abstract struct RequestPort {
    bool isConnected();
    void sendMessage(Packet* pkt, bool timing);
    void sendCallback(Packet* pkt, bool timing, auto callback);
}
abstract struct BaseInterrupts {}
abstract struct LocalApic {
    b32 readReg(int offset);
    int getInitialApicId();
}
abstract struct BaseCPU { BaseInterrupts* getInterruptController(int index); }
abstract struct ThreadContext { BaseCPU* getCpuPtr(); }
abstract struct System {
    vector<ThreadContext*> threads;
    bool isTimingMode();
}
abstract struct I82094AAParams {
    int apic_id;
    b64 int_latency;
    int port_inputs_connection_count;
}
abstract TriggerMessage makeMessage(b32 value);
abstract LocalApic* localApic(BaseInterrupts* interrupts);
abstract Packet* buildAck();
abstract Packet* buildTrigger(int id, TriggerMessage message);
abstract void freePacket(Packet* pkt);
abstract auto bindMessage(auto callback, TriggerMessage message);
abstract int logicalDestinationReg;

device I82094AA {
    b8 regSel;
    b8 initialApicId;
    b8 id;
    b8 arbId;
    b64 lowestPriorityOffset;
    b64 redirTable[24];
    bool pinStates[24];
    vector<IntSinkPinBase*> inputs;
    RequestPort intRequestPort;
    auto ackCallback = [](TriggerMessage message, Packet* pkt) {
        message.vector = pkt.getByte();
        signalInterrupt(message);
        freePacket(pkt);
    };
    abstract b64 pioAddr;
    abstract b64 pioDelay;
    abstract System* sys;
    abstract string name();
    abstract void basicInit();

    constructor(I82094AAParams& params) : regSel(0), initialApicId(params.apic_id), id(params.apic_id),
        arbId(params.apic_id), lowestPriorityOffset(0), intRequestPort(name() + ".int_request", self, self, params.int_latency) {
        require(params.apic_id < 0xff);
        for (int i = 0; i < 24; ++i) {
            redirTable.set(i, 0x10000);
            pinStates.set(i, 0);
        }
        for (int i = 0; i < params.port_inputs_connection_count; ++i) {
            inputs.push(newSinkPin(name() + ".inputs[" + toString(i) + "]", i, self));
        }
    }
    void init() {
        basicInit();
        panicIf(intRequestPort.isConnected() == 0, "Int port not connected to anything");
    }
    register select: size(4), offset(0) {
        b32 read() { return regSel; }
        void write(b32 data) { regSel = static_cast<b8>(data); }
    }
    register window: size(4), offset(16) {
        b32 read() { return readReg(regSel); }
        void write(b32 data) { writeReg(regSel, data); }
    }
    b64 read(Packet* pkt) {
        require(pkt.getSize() == 4);
        b64 offset = pkt.getAddr() - pioAddr;
        if (offset == 0) { pkt.setWord(select.read()); }
        else if (offset == 16) { pkt.setWord(window.read()); }
        else { fail("Illegal read from I/O APIC"); }
        pkt.makeAtomicResponse();
        return pioDelay;
    }
    b64 write(Packet* pkt) {
        require(pkt.getSize() == 4);
        b64 offset = pkt.getAddr() - pioAddr;
        if (offset == 0) { select.write(pkt.getWord()); }
        else if (offset == 16) { window.write(pkt.getWord()); }
        else { fail("Illegal write to I/O APIC"); }
        pkt.makeAtomicResponse();
        return pioDelay;
    }
    void writeReg(b8 offset, b32 value) {
        if (offset == 0) { id = static_cast<b8>(value >> 24); }
        else if (offset == 1) { }
        else if (offset == 2) { arbId = static_cast<b8>(value >> 24); }
        else if ((offset >= 0x10) & (offset <= 0x40)) {
            int index = (offset - 0x10) / 2;
            b64 entry = redirTable.at(index);
            if ((offset % 2) != 0) {
                entry = (entry & 0xffffffff) | (static_cast<b64>(value & 0xff000000) << 32);
            } else {
                entry = (entry & 0xffffffff00000000) | (value & 0x1ffff);
            }
            redirTable.set(index, entry);
        } else { warn("Access to undefined I/O APIC register"); }
    }
    b32 readReg(b8 offset) {
        if (offset == 0) { return static_cast<b32>(id) << 24; }
        else if (offset == 1) { return 0x170014; }
        else if (offset == 2) { return static_cast<b32>(arbId) << 24; }
        else if ((offset >= 0x10) & (offset <= 0x40)) {
            int index = (offset - 0x10) / 2;
            if ((offset % 2) != 0) { return static_cast<b32>(redirTable.at(index) >> 32); }
            return static_cast<b32>(redirTable.at(index));
        }
        warn("Access to undefined I/O APIC register");
        return 0;
    }
    void requestInterrupt(int line) {
        require(line < 24);
        b64 entry = redirTable.at(line);
        if (((entry >> 16) & 1) != 0) { return; }
        TriggerMessage message = makeMessage(0);
        message.destination = static_cast<b32>(entry >> 56);
        message.deliveryMode = static_cast<b32>((entry >> 8) & 7);
        message.destMode = static_cast<b32>((entry >> 11) & 1);
        message.level = static_cast<b32>((entry >> 13) & 1);
        message.trigger = static_cast<b32>((entry >> 15) & 1);
        if (message.deliveryMode == 7) {
            Packet* pkt = buildAck();
            intRequestPort.sendCallback(pkt, sys.isTimingMode(), bindMessage(ackCallback, message));
        } else {
            message.vector = static_cast<b32>(entry & 0xff);
            signalInterrupt(message);
        }
    }
    void signalInterrupt(TriggerMessage message) {
        vector<int> apics;
        int numContexts = sys.threads.size();
        if (message.destMode == 0) {
            panicIf(message.deliveryMode == 1, "Lowest priority delivery unsupported in physical destination mode");
            if (message.destination == 0xff) {
                for (int i = 0; i < numContexts; ++i) { apics.push(i); }
            } else { apics.push(message.destination); }
        } else {
            for (int i = 0; i < numContexts; ++i) {
                BaseInterrupts* base = sys.threads.at(i).getCpuPtr().getInterruptController(0);
                LocalApic* lapic = localApic(base);
                if (((lapic.readReg(logicalDestinationReg) >> 24) & message.destination) != 0) {
                    apics.push(lapic.getInitialApicId());
                }
            }
            if ((message.deliveryMode == 1) & (apics.size() != 0)) {
                b64 modOffset = lowestPriorityOffset % apics.size();
                lowestPriorityOffset += 1;
                int selected = apics.at(modOffset);
                apics.clear();
                apics.push(selected);
            }
        }
        for (int i = 0; i < apics.size(); ++i) {
            Packet* pkt = buildTrigger(apics.at(i), message);
            intRequestPort.sendMessage(pkt, sys.isTimingMode());
        }
    }
    void raiseInterruptPin(int number) {
        require(number < 24);
        if (pinStates.at(number) == 0) { requestInterrupt(number); }
        pinStates.set(number, 1);
    }
    void lowerInterruptPin(int number) {
        require(number < 24);
        pinStates.set(number, 0);
    }
    void serialize(CheckpointOut& cp) const {
        saveScalar(cp, "regSel", regSel);
        saveScalar(cp, "initialApicId", initialApicId);
        saveScalar(cp, "id", id);
        saveScalar(cp, "arbId", arbId);
        saveScalar(cp, "lowestPriorityOffset", lowestPriorityOffset);
        saveArray(cp, "redirTableArray", redirTable);
        saveArray(cp, "pinStates", pinStates);
    }
    void unserialize(CheckpointIn& cp) {
        regSel = static_cast<b8>(loadScalar(cp, "regSel"));
        initialApicId = static_cast<b8>(loadScalar(cp, "initialApicId"));
        id = static_cast<b8>(loadScalar(cp, "id"));
        arbId = static_cast<b8>(loadScalar(cp, "arbId"));
        lowestPriorityOffset = static_cast<b64>(loadScalar(cp, "lowestPriorityOffset"));
        loadArray(cp, "redirTableArray", redirTable);
        loadArray(cp, "pinStates", pinStates);
    }
}
